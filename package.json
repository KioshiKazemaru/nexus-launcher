{
  "name": "nexus-launcher",
  "productName": "Nexus Launcher",
  "version": "0.15.6",
  "private": true,
  "description": "Unified Steam and Epic library for Windows, macOS and Linux",
  "main": "src/main.cjs",
  "desktopName": "nexus-launcher.desktop",
  "author": {
    "name": "Nexus",
    "email": "KioshiKazemaru@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --require ./test/helpers/register-electron.cjs --test test/*.test.cjs test/services/*.test.cjs",
    "test:live": "node --test test/live/*.live.cjs",
    "lint": "eslint src test ui",
    "format": "prettier --write \"src/**/*.cjs\" \"test/**/*.cjs\" \"ui/app-*.js\" ui/bigpicture.js ui/friends.js ui/chat.js ui/chat-media.js ui/browser.js ui/browser.css ui/social-common.js ui/overlay.js ui/hud.js ui/style.css ui/social.css ui/overlay.css",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "release": "electron-builder --win nsis --x64 --publish always",
    "pack:win": "electron-builder --win dir --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --publish never",
    "pack:linux": "electron-builder --linux dir --x64 --publish never",
    "test:ui": "node --test test/ui/*.test.cjs"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "electron-updater": "^6.8.11",
    "steam-user": "5.3.0"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9.17.0",
    "playwright": "^1.49.1",
    "prettier": "^3.4.2"
  },
  "build": {
    "appId": "nexus.launcher",
    "productName": "Nexus Launcher",
    "generateUpdatesFilesForAllChannels": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "ui/assets/nexus.ico",
      "signtoolOptions": {
        "publisherName": "Nexus",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "artifactName": "Nexus-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Nexus"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "KioshiKazemaru",
        "repo": "nexus-launcher",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "ui/assets/nexus.png",
      "artifactName": "Nexus-${version}-mac-${arch}.${ext}",
      "darkModeSupport": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "icon": "ui/assets/nexus.png",
      "executableName": "nexus-launcher",
      "synopsis": "Steam + Epic Games library",
      "artifactName": "Nexus-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Nexus Launcher",
          "Comment": "Steam + Epic Games"
        }
      },
      "syncDesktopName": true
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "homepage": "https://github.com/KioshiKazemaru/nexus-launcher",
  "overrides": {
    "steam-appticket": "^2.0.1",
    "adm-zip": "^0.6.1"
  }
}
